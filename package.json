{
  "name": "gmail-e2ee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "build:extension": "node scripts/build-extension.mjs",
    "test": "vitest run",
    "build:extension:e2e": "node scripts/build-extension.mjs --e2e",
    "test:e2e": "npm run build:extension:e2e && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.7",
    "@types/node": "22.20.5",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "openpgp": "6.3.2"
  }
}
