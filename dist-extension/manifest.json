{
  "manifest_version": 3,
  "name": "Gmail E2EE (OpenPGP prototype)",
  "version": "0.1.0",
  "description": "Educational prototype: OpenPGP encryption with verified contacts for the Gmail website.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Gmail E2EE",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
